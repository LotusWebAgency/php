Fixes: The preserve_none probe in Zend/Zend.m4 leaves x20 out of its aarch64 clobbers, so clang 19 with ThinLTO fails it and arm64 silently gets the CALL VM instead of TAILCALL.
Origin: php-src commit a1cb5a37c0
Upstream: merged: php-src master (#23883); no PHP-8.5 release carries it yet
Drop-when: an 8.5 release carries the commit (patch --forward fails the build if it is applied twice)
Source: php-src commit a1cb5a37c0 ("fix aarch64 gcc preserve_none detection"), applied verbatim.

--- a/Zend/Zend.m4
+++ b/Zend/Zend.m4
@@ -494,7 +494,7 @@
 	return (uintptr_t)const3;
 }
 
-uintptr_t __attribute__((preserve_none)) test(void) {
+uintptr_t __attribute__((preserve_none,noinline)) test(void) {
 	uintptr_t ret;
 
 #if defined(__x86_64__)
@@ -512,7 +512,7 @@
 #endif
 		: "=a" (ret)
 		: "r" (const1), "r" (const2), "r" (key)
-		: "r12", "r13"
+		: "r12", "r13", "memory", "cc"
 	);
 #elif defined(__aarch64__)
 	__asm__ __volatile__(
@@ -528,7 +528,7 @@
 		"mov    %0, x0\n"
 		: "=r" (ret)
 		: "r" (const1), "r" (const2), "r" (key)
-		: "x0", "x21", "x22", "x30"
+		: "x0", "x20", "x21", "x30", "memory", "cc"
 	);
 #else
 # error
