+static void sp_upload_validate_file(const char *filename, const char *tmp_name, size_t filesize) {
+  const sp_config_upload_validation *config_upload = &(SPCFG(upload_validation));
+  pid_t pid;
+  char *cmd[3] = {0};
+  char *env[5] = {0};
+
+  sp_log_debug("Filename: %s\nTmpname: %s\nSize: %zd\nScript: %s",
+               filename, tmp_name, filesize, ZSTR_VAL(config_upload->script));
+
+  cmd[0] = ZSTR_VAL(config_upload->script);
+  cmd[1] = (char *)tmp_name;
+  cmd[2] = NULL;
+
+  const char *remote_addr = getenv("REMOTE_ADDR");
+  spprintf(&env[0], 0, "SP_FILENAME=%s", filename);
+  spprintf(&env[1], 0, "SP_REMOTE_ADDR=%s", remote_addr ? remote_addr : "");
+  spprintf(&env[2], 0, "SP_CURRENT_FILE=%s", zend_get_executed_filename(TSRMLS_C));
+  spprintf(&env[3], 0, "SP_FILESIZE=%zu", filesize);
+  env[4] = NULL;
+
+  if ((pid = fork()) == 0) {
+    if (execve(ZSTR_VAL(config_upload->script), cmd, env) == -1) {
+      sp_log_warn("upload_validation", "Could not call '%s' : %s", ZSTR_VAL(config_upload->script), strerror(errno));
+      _exit(1);
+    }
+  } else if (pid == -1) {
+    // LCOV_EXCL_START
+    sp_log_err("upload_validation", "Could not fork process : %s\n", strerror(errno));
+    EFREE_3(env);
+    return;
+    // LCOV_EXCL_STOP
+  }
+
+  EFREE_3(env);
+  int waitstatus;
+  waitpid(pid, &waitstatus, 0);
+  if (WEXITSTATUS(waitstatus) != 0) {  // Nope
+    char *uri = getenv("REQUEST_URI");
+    int sim = config_upload->simulation;
+    sp_log_auto("upload_validation", sim, "The upload of %s on %s was rejected.", filename, uri ? uri : "?");
+  }
+}
+
+/* $_FILES[field] holds name, tmp_name, size and error as scalars for a plain field
+ * and as parallel arrays with identical keys for `f[]`, `f[k]` and `f[a][b]`.
+ * Walk them together; tmp_name drives the traversal. Only a leaf with a non-empty
+ * tmp_name and UPLOAD_ERR_OK has a temp file on disk, so any other leaf is skipped. */
+static void sp_upload_validate_zvals(zval *name, zval *tmp_name, zval *size, zval *error) {
+  if (tmp_name == NULL) {
+    return;
+  }
+
+  if (Z_TYPE_P(tmp_name) == IS_ARRAY) {
+    zend_ulong h;
+    zend_string *key;
+    zval *tmp_child;
+
+    ZEND_HASH_FOREACH_KEY_VAL(Z_ARRVAL_P(tmp_name), h, key, tmp_child) {
+      sp_upload_validate_zvals(sp_upload_sibling(name, key, h), tmp_child,
+                               sp_upload_sibling(size, key, h),
+                               sp_upload_sibling(error, key, h));
+    }
+    ZEND_HASH_FOREACH_END();
+    return;
+  }
+
+  if (Z_TYPE_P(tmp_name) != IS_STRING || Z_STRLEN_P(tmp_name) == 0) {
+    return;
+  }
+  if (error == NULL || Z_TYPE_P(error) != IS_LONG || Z_LVAL_P(error) != UPLOAD_ERR_OK) {
+    return;
+  }
+
+  const char *filename = (name != NULL && Z_TYPE_P(name) == IS_STRING) ? Z_STRVAL_P(name) : "";
+  size_t filesize = (size != NULL && Z_TYPE_P(size) == IS_LONG && Z_LVAL_P(size) > 0)
+                        ? (size_t)Z_LVAL_P(size) : 0;
+
+  sp_upload_validate_file(filename, Z_STRVAL_P(tmp_name), filesize);
+}
+
