# Copied to /corpus/laravel/.env by Dockerfile.corpus for every Laravel version.
#
# Not .env.example: Laravel 6's ships DB_CONNECTION=mysql and the corpus has no
# database server. DB_DATABASE is absent so every version falls back to
# database_path('database.sqlite') and no corpus path is baked into the file.
#
# APP_ENV/APP_DEBUG are the production pair: a profile trained against the debug
# bootstrap optimizes code the shipped images never run. Keys are the union of old
# and new names (CACHE_DRIVER is Laravel 6, CACHE_STORE is Laravel 11+); an unread
# key is ignored.
APP_NAME=PGOCorpus
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1
LOG_CHANNEL=stack
LOG_LEVEL=error
DB_CONNECTION=sqlite
BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
MAIL_MAILER=log
