{
    "name": "dementev/pgo-corpus-symfony",
    "description": "Symfony workload for the lotuswebagency/php PGO training corpus.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.1.3",
        "ext-pdo_sqlite": "*",
        "symfony/console": "^4.4",
        "symfony/dotenv": "^4.4",
        "symfony/framework-bundle": "^4.4",
        "symfony/twig-bundle": "^4.4",
        "symfony/yaml": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "7.1.33"
        },
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
