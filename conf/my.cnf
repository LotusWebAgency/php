# Read by the MariaDB client tools only ([client-mariadb]); PHP's mysqlnd ignores it.
# The MariaDB 11.4+ client requires TLS with a verified certificate by default, so
# it refuses a server without TLS (MariaDB before 11.4 out of the box). With
# verification off it still negotiates TLS whenever the server offers it and falls
# back to plaintext otherwise, like MySQL's --ssl-mode=PREFERRED.
# --ssl-verify-server-cert restores the strict default for one invocation.
[client-mariadb]
ssl-verify-server-cert = 0
