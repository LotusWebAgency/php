<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
  <!ELEMENT policymap (policy)*>
  <!ATTLIST policymap
    xmlns CDATA #FIXED ""
  >

  <!ELEMENT policy EMPTY>
  <!ATTLIST policy
    xmlns   CDATA   #FIXED ""
    domain  NMTOKEN #REQUIRED
    name    NMTOKEN #IMPLIED
    pattern CDATA   #IMPLIED
    rights  NMTOKEN #IMPLIED
    stealth NMTOKEN #IMPLIED
    value   CDATA   #IMPLIED
  >
]>

<!--
  ImageMagick security policy for lotuswebagency/php, derived from the upstream
  policy-secure and policy-websafe templates. Installed at
  /opt/imagemagick/etc/ImageMagick-7/policy.xml; mount your own file over that
  path to replace it.

  ImageMagick evaluates a domain's policies in order and the last match wins:
  the broad deny comes first, the exceptions after it.
-->
<policymap>
  <!-- Resource limits: one hostile upload must not exhaust the container. -->
  <policy domain="resource" name="thread" value="1"/>
  <policy domain="resource" name="time" value="120"/>
  <policy domain="resource" name="file" value="768"/>
  <policy domain="resource" name="memory" value="256MiB"/>
  <policy domain="resource" name="map" value="512MiB"/>
  <policy domain="resource" name="area" value="128MP"/>
  <policy domain="resource" name="disk" value="1GiB"/>
  <policy domain="resource" name="list-length" value="256"/>
  <policy domain="resource" name="width" value="16KP"/>
  <policy domain="resource" name="height" value="16KP"/>
  <policy domain="system" name="max-memory-request" value="256MiB"/>
  <policy domain="system" name="max-profile-size" value="16MiB"/>
  <policy domain="system" name="max-profile-count" value="16"/>

  <!-- Indirect reads (@file), stdin/stdout, descriptors, pipes and system paths. -->
  <policy domain="path" rights="none" pattern="-"/>
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="path" rights="none" pattern="[Ff][Dd\\]:*"/>
  <policy domain="path" rights="none" pattern="|*"/>
  <policy domain="path" rights="none" pattern="/etc/*"/>
  <policy domain="path" rights="none" pattern="/proc/*"/>
  <policy domain="path" rights="none" pattern="/sys/*"/>

  <!-- No external programs and no loadable filters. -->
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="filter" rights="none" pattern="*"/>
  <policy domain="module" rights="none" pattern="{MSL,URL,VIDEO}"/>

  <!-- Coders: deny everything, then allow the raster formats this build is for. -->
  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read|write" pattern="{GIF*,JPEG,JPG,JPE,PJPEG,PNG*,WEBP,TIF*,BMP*,ICO,ICON}"/>
  <!-- Solid-color and gradient pseudo-formats read no files and no network. -->
  <policy domain="coder" rights="read" pattern="{XC,CANVAS,GRADIENT,RADIAL-GRADIENT}"/>
  <!-- HEIC, HEIF and AVIF are decode-only in this build. -->
  <policy domain="coder" rights="read" pattern="{HEIC,HEIF,AVIF}"/>
  <!-- Network, scripting, vector, page-description and text coders stay off even if the allow list above grows. -->
  <policy domain="coder" rights="none" pattern="{URL,HTTP,HTTPS,FTP,FILE,MVG,MSVG,MSL,SVG,SVGZ,EPHEMERAL,LABEL,CAPTION,TEXT,TXT,INLINE,PS,PS2,PS3,EPS,EPS2,EPS3,EPSF,EPSI,EPT,EPDF,PDF,PDFA,XPS,PCL,VIDEO}"/>
</policymap>
