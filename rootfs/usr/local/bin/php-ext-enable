#!/usr/bin/env bash
# Enable shared extensions by writing ini files. Idempotent; refuses names that
# have no .so, so a typo fails loudly instead of silently doing nothing.
set -euo pipefail

# Zend extensions load through a different directive (zend_extension= instead
# of extension=). xdebug hooks the engine's op array execution and refuses to
# load any other way ("Xdebug MUST be loaded as a Zend extension"). pcov is
# NOT in this list even though it is also a coverage driver -- verified
# empirically, pcov registers as a plain extension and zend_extension=pcov
# fails to load at all ("doesn't appear to be a valid Zend extension").
# opcache is a zend extension too but never reaches this script -- it's
# compiled in and enabled by task 10's baseline ini. snuffleupagus (task 12)
# does reach this script: docker-php-entrypoint's PHP_SNUFFLEUPAGUS branch
# calls `php-ext-enable snuffleupagus` directly before writing its
# sp.configuration_file directive.
ZEND_EXTENSIONS="xdebug opcache snuffleupagus"
is_zend() {
  case " $ZEND_EXTENSIONS " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

# --list-zend prints that same list, one name per line, and exits. Nothing in
# the image needs it; tests/smoke.sh does. That check has to exercise the
# zend_extension= path with a name that actually exists on the version under
# test -- xdebug's pecl.lock-pinned package declares a PHP 8.0 floor, so
# ext.json excludes it from the 7.x images entirely and the hard-coded "xdebug"
# subject the check used to name fails there on a missing .so. Asking this
# script keeps the answer in the one place that decides it. It reads the same
# variable is_zend() does, so the two cannot disagree.
if [ "${1:-}" = "--list-zend" ]; then
  printf '%s\n' $ZEND_EXTENSIONS
  exit 0
fi

CONF_DIR="${PHP_CONF_DIR:-/usr/local/etc/php/conf.d}"
EXT_DIR="$(php -r 'echo ini_get("extension_dir");')"

# The 20-<name>.ini filename this script writes below is currently safe
# against path traversal only because the literal "20-" prefix turns a
# leading ../ into a bogus directory component that fails rather than
# escaping conf.d -- emergent, not designed. Reject anything that isn't a
# real extension name outright, so that protection doesn't depend on nobody
# ever changing the filename template.
is_valid_name() {
  case "$1" in
    ''|*[!A-Za-z0-9_]*) return 1 ;;
    *) return 0 ;;
  esac
}

for name in "$@"; do
  name="$(echo "$name" | tr -d ' ')"
  [ -n "$name" ] || continue
  if ! is_valid_name "$name"; then
    echo "php-ext-enable: invalid extension name: '${name}'" >&2
    exit 1
  fi
  if [ ! -f "${EXT_DIR}/${name}.so" ]; then
    echo "php-ext-enable: no such extension: ${name}" >&2
    echo "available: $(cd "$EXT_DIR" && ls *.so 2>/dev/null | sed 's/\.so$//' | tr '\n' ' ')" >&2
    exit 1
  fi
  # ".so", always, for both directives. PHP only began appending a file
  # extension to an extension=/zend_extension= value that has none somewhere
  # after 7.1: on 7.0.33 and 7.1.33 "extension=lz4" resolves to
  # <extension_dir>/lz4 and fails with "Unable to load dynamic library ...
  # cannot open shared object file" on every single php invocation, and
  # "zend_extension=opcache" fails the same way. Measured on the built images:
  # the bare name fails on 7.0/7.1 and works from 7.2 on, while the suffixed
  # form works on 7.0, 7.2 and 8.5 alike -- so it is written unconditionally
  # rather than gated on a version this script would otherwise have to know.
  if is_zend "$name"; then
    echo "zend_extension=${name}.so" > "${CONF_DIR}/20-${name}.ini"
  else
    echo "extension=${name}.so" > "${CONF_DIR}/20-${name}.ini"
  fi
  echo "enabled ${name}"
done
